# Server
PORT=3090
HOST=127.0.0.1
NODE_ENV=development

# Admin write access
ADMIN_PASSWORD=admin2026
ADMIN_TOKEN_SECRET=change-me

# Supabase (ax-hub Library 저장소)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# ax-pjt-dashboard (홈 대시보드·과제 이관 소스 — 필수)
DASHBOARD_SUPABASE_URL=https://DASHBOARD_PROJECT_REF.supabase.co
DASHBOARD_SUPABASE_SECRET_KEY=sb_secret_...

# Optional aliases
# SUPABASE_SERVICE_ROLE_KEY=...
# DATABASE_URL=postgresql://postgres.YOUR_REF:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# PGHOST=aws-0-ap-south-1.pooler.supabase.com
# PGPORT=6543
# PGDATABASE=postgres
# PGUSER=postgres.YOUR_REF

# Gemini (Best Practice PDF 분석)
# Python 대응: genai.configure(api_key=...); genai.GenerativeModel('gemini-3.5-flash-lite')
# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Vercel Environment Variables (필수)
# SUPABASE_URL, SUPABASE_SECRET_KEY, DASHBOARD_SUPABASE_URL, DASHBOARD_SUPABASE_SECRET_KEY
# ADMIN_PASSWORD, ADMIN_TOKEN_SECRET
# (선택) GEMINI_API_KEY, GEMINI_MODEL
# DATABASE_URL은 로컬 마이그레이션용 — Vercel 런타임에는 불필요
